# Auth is the Claude Agent SDK's: your Claude Code login (~/.claude) — i.e. your
# subscription — is used automatically. Set a key ONLY to use API billing instead.
# ANTHROPIC_API_KEY=sk-ant-...

# All optional — these are the defaults.
# The outcome the agent establishes and builds (a fresh sibling of the system repo):
# WORKSPACE=../roli-admin-genesis
# The observation ledger directory the run reads:
# OBSERVATIONS=./observations
# Read-only sources to observe, comma-separated name=path pairs (empty = greenfield):
# OBSERVE_SOURCES=admin-roli=../../admin.roli.com
# Reach charter: genesis | maintenance
# CHARTER=genesis
# ENVELOPE_BIN=../envelope/target/debug/envelope
# CONDUCTOR_AUDIT=./conductor-audit.jsonl
# MAX_TURNS=60
